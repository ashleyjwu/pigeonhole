# Copy to `.env` and fill in real values. Never commit `.env`.

# ── Postgres (Neon) — same database as the web app ──
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Redis (Upstash) — job queue + cache ──
# A standard redis:// / rediss:// URL is simplest for the Python worker.
REDIS_URL=rediss://default:password@host:6379

# ── Spotify (for refreshing user access tokens during background sync) ──
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret

# ── Last.fm (artist genre tags — Spotify removed genres for dev-mode apps) ──
# Free key: https://www.last.fm/api/account/create
LASTFM_API_KEY=your-lastfm-api-key

# ── Token encryption — MUST match the web app's TOKEN_ENCRYPTION_KEY ──
TOKEN_ENCRYPTION_KEY=generate-me
