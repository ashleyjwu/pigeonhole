# Copy to `.env.local` and fill in real values. Never commit `.env.local`.

# ── Spotify OAuth ──
# Auth.js reads these two automatically for the Spotify provider.
AUTH_SPOTIFY_ID=your-spotify-client-id
AUTH_SPOTIFY_SECRET=your-spotify-client-secret
# Register this redirect URI in your Spotify app dashboard.
# Use 127.0.0.1, NOT localhost — Spotify rejects localhost:
#   http://127.0.0.1:3000/api/auth/callback/spotify

# Auth.js session secret. Generate with: openssl rand -base64 32
AUTH_SECRET=generate-me

# Base URLs for local dev (match the Spotify redirect host: 127.0.0.1).
AUTH_URL=http://127.0.0.1:3000
APP_BASE_URL=http://127.0.0.1:3000

# ── Postgres (Neon) ──
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Redis (Upstash) ──
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ── Token encryption (AES-256-GCM), 32-byte base64 key. openssl rand -base64 32 ──
# Must match the worker's TOKEN_ENCRYPTION_KEY so both can decrypt stored tokens.
TOKEN_ENCRYPTION_KEY=generate-me
